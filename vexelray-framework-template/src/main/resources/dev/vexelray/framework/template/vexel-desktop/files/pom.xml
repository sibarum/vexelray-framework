<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>${artifactId}</name>
    <description>
        ${summary}
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-framework.version>${frameworkVersion}</vexelray-framework.version>
        <vexelray-gui.version>${guiVersion}</vexelray-gui.version>
        <vexelray.version>${vexelrayVersion}</vexelray.version>
        <tactroller.version>${tactrollerVersion}</tactroller.version>
        <vexelray-codec.version>${codecVersion}</vexelray-codec.version>
        <junit.version>${junitVersion}</junit.version>

        <app.mainClass>${packageName}.${className}</app.mainClass>

        <!--
          Program args for exec:exec, split on whitespace by the commandlineArgs form below. Empty is the
          interactive run; a multi-word value is several arguments rather than one.
        -->
        <app.args></app.args>

        <!--
          The automation driver: "off", "on" for the default port, or a port number. Empty says nothing, so
          VEXELRAY_AUTOMATION in the environment decides, and with that unset the sockets stay off.
        -->
        <automation></automation>

        <!--
          Extra JVM flags for exec:exec, split on whitespace. Needed because a -D on the mvn command line sets a
          MAVEN property, which reaches the forked JVM only if the command line below names it: without this,
          "mvn exec:exec -Dmy.setting=48" runs the app with the default and reports a measurement of nothing.
        -->
        <app.jvmArgs></app.jvmArgs>
    </properties>

    <dependencies>
        <!-- The application framework: the edge this project would otherwise write for itself. Its -shell
             module brings vexelray-gui-core, -krono, -widget and tactroller with it, and owns the input
             backend, the clipboard, the window memory, the clock, the frame loop and the shutdown. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <version>$${vexelray-framework.version}</version>
        </dependency>
        <!-- The automation sockets, remote control and diagnostics, as a framework component: in every build, the
             release one too, off until the launch or the title bar's plug switches one on, and the plug's lamps
             showing what is open and what is or was connected. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-automation</artifactId>
            <version>$${vexelray-framework.version}</version>
        </dependency>
        <!-- The widget shelf, and the framework core and draw modules behind it. Reached through -shell as
             well; named here because this project's own Ui builds against it directly. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>$${vexelray-gui.version}</version>
        </dependency>
        <!-- The clock. Motion enters at the application edge and nowhere else: -widget declares seams shaped
             out of JDK types and this module satisfies them, so a widget animates without naming Kronometer. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
            <version>$${vexelray-gui.version}</version>
        </dependency>
        <!-- Driving the running app the way a person does: real window, real Vulkan, real frame loop
             (vexelray-gui/docs/reference/automation.md). -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>$${vexelray-gui.version}</version>
        </dependency>
        <!-- Input at the application edge: the tactroller->atchung bridge (brings tactroller-api and
             atchung-core transitively, which is where State and Committer come from). -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>$${tactroller.version}</version>
        </dependency>
        <!-- Standalone OS clipboard; no input-subsystem coupling. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>$${tactroller.version}</version>
        </dependency>
        <!-- The title bar's camera records video as well as taking screenshots: found through ServiceLoader, so this
             dependency is all it takes. AV1 into Matroska, through an FFmpeg that holds the AV1 encoders and no
             decoder (ffmpeg-wrapper-record). -->
        <dependency>
            <groupId>dev.vexelray.codec</groupId>
            <artifactId>vexelray-codec-record</artifactId>
            <version>$${vexelray-codec.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>$${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The mark, on the class path for the window: the same file src/main/rc/${artifactId}.rc links into the
                 executable, so the two are one file and cannot drift. @VexelApp(icon) names it. -->
            <resource>
                <directory>src/main/rc</directory>
                <includes>
                    <include>${artifactId}.ico</include>
                </includes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>0.10.6</version>
                    <executions>
                        <execution>
                            <id>build-native</id>
                            <goals><goal>compile-no-fork</goal></goals>
                            <phase>package</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <imageName>$${native.imageName}</imageName>
                        <mainClass>$${app.mainClass}</mainClass>
                        <buildArgs>
                            <!-- The FFM flags, the shaders, the font atlas and the icon's registration come from
                                 the libraries' and the processor's own META-INF/native-image metadata; only what
                                 is this program's is set here. -->
                            <buildArg>--no-fallback</buildArg>
                            <!-- WINDOWS needs /ENTRY:mainCRTStartup as well: the linker would otherwise look for
                                 WinMain, and the image's entry is the C main. CONSOLE is the linker's default,
                                 spelled out so both builds pass the same two options. -->
                            <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:$${native.subsystem}</buildArg>
                            <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                            <buildArg>-H:NativeLinkerOption=$${project.build.directory}/${artifactId}.res</buildArg>
                        </buildArgs>
                    </configuration>
                </plugin>
                <!-- The executable's icon: a resource linked into the program, so it has to exist as a compiled .res
                     before link time. rc.exe is the Windows SDK's resource compiler and must be on PATH, as it is in a
                     Visual Studio developer prompt (which the native build already needs for link.exe).
                     native-build.cmd makes one and runs mvn in it, so it is looked for first: without it the failure
                     would be exec's 'not recognized', which names neither the cause nor the fix. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <execution>
                            <id>compile-icon-resource</id>
                            <phase>prepare-package</phase>
                            <goals><goal>run</goal></goals>
                            <configuration>
                                <target>
                                    <available file="rc.exe" filepath="$${env.PATH}" property="rc.exe.found"/>
                                    <fail unless="rc.exe.found" message="rc.exe, the Windows SDK's resource compiler (for the icon), is not on PATH, and neither is the MSVC link.exe that native-image needs: they are only there in a Visual Studio developer prompt. Run the native build through native-build.cmd, which loads that environment and then runs mvn with its arguments, e.g. native-build.cmd -Pnative package -DskipTests (./native-build.cmd from Git Bash)."/>
                                    <exec executable="rc.exe" searchpath="true" failonerror="true">
                                        <arg value="/nologo"/>
                                        <arg value="/fo"/>
                                        <arg file="$${project.build.directory}/${artifactId}.res"/>
                                        <arg file="$${project.basedir}/src/main/rc/${artifactId}.rc"/>
                                    </exec>
                                </target>
                            </configuration>
                        </execution>
                        <!-- The recording encoder (see ffmpeg-record-beside) laid out flat in target/ffmpeg-record, and
                             zipped for installer.json, which unpacks it into the install's own ffmpeg-record folder.
                             Fixed times, so the same libraries make the same zip and an installer that already has
                             its hash skips the download. -->
                        <execution>
                            <id>ffmpeg-record-zip</id>
                            <phase>prepare-package</phase>
                            <goals><goal>run</goal></goals>
                            <configuration>
                                <target>
                                    <delete dir="$${project.build.directory}/ffmpeg-record"/>
                                    <copy todir="$${project.build.directory}/ffmpeg-record" flatten="true">
                                        <fileset dir="$${project.build.directory}/ffmpeg-wrapper-record/natives/record/windows-x86_64"/>
                                    </copy>
                                    <delete file="$${project.build.directory}/${artifactId}-ffmpeg-record-windows-x86_64.zip"/>
                                    <zip destfile="$${project.build.directory}/${artifactId}-ffmpeg-record-windows-x86_64.zip"
                                         basedir="$${project.build.directory}/ffmpeg-record"
                                         modificationtime="2026-01-01T00:00:00Z"/>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- The camera's video recording beside the executable. ffmpeg-wrapper-record-windows's encoder (AV1 into
                     Matroska, 14 MB) is not a resource of the image, so it is taken out of its jar (into
                     target/ffmpeg-wrapper-record, then flattened into target/ffmpeg-record by ffmpeg-record-zip), where
                     its loader looks beside an executable run from target/. Without it a native build offers
                     "Record video to file…" and fails when it is clicked. FFmpeg's and SVT-AV1's licences come out
                     with the libraries. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.7.0</version>
                    <executions>
                        <execution>
                            <id>ffmpeg-record-beside</id>
                            <phase>prepare-package</phase>
                            <goals><goal>unpack-dependencies</goal></goals>
                            <configuration>
                                <includeArtifactIds>ffmpeg-wrapper-record-windows</includeArtifactIds>
                                <includes>natives/record/windows-x86_64/**</includes>
                                <outputDirectory>$${project.build.directory}/ffmpeg-wrapper-record</outputDirectory>
                                <overWriteReleases>true</overWriteReleases>
                                <overWriteSnapshots>true</overWriteSnapshots>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Stamps this build with the exact source of its binaries (the commit, plus a digest of any uncommitted
                 change), so whatever is built on it knows what it was built from. See vexelray-build/README.md. -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>${buildVersion}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>identify</goal>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>$${maven.compiler.release}</release>
                    <!-- The framework's annotation processor: what its vocabulary calls a compile error is
                         one. Named rather than found, because since JDK 23 javac runs no processor it merely
                         finds on the class path. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>dev.vexelray.framework</groupId>
                            <artifactId>vexelray-framework-processor</artifactId>
                            <version>$${vexelray-framework.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!--
              LWJGL is not part of this stack, and an application that pulls it in is incompatible with the
              framework: the stack owns its windowing and Vulkan through Panama, and LWJGL brings a second
              copy of both. The only module that still uses it, supirvast's vastir-preview, is a dev tool that
              is never installed. So nothing here should reach it, and if something does, this fails the build.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>no-lwjgl</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.lwjgl</exclude>
                                    </excludes>
                                    <message>LWJGL is not part of the VexelRay stack: find which dependency brings it with mvn dependency:tree and remove that edge.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Run in a fresh JVM: mvn compile exec:exec
              exec:exec rather than exec:java so native access can be enabled for Panama FFM.

              One command line split on whitespace, rather than a list of argument elements. An argument
              element is exactly one token and a property cannot expand into several, so a multi-word
              app.args would arrive as a single argument. %classpath is substituted after the split, so it
              stays one argument even where a path contains a space.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>$${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED -Dstdout.encoding=UTF-8 -Dautomation=$${automation} "-Dbuild.dir=$${project.build.directory}" $${app.jvmArgs} -classpath %classpath $${app.mainClass} $${app.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>$${project.basedir}/target-linux</directory>
            </build>
        </profile>
        <!--
          GraalVM native images; both need a GraalVM JDK (JAVA_HOME) and are profile-gated because native-image
          takes minutes. This program's own reachability metadata is under src/main/resources/META-INF/native-image/;
          the libraries and the processor bring the rest.

            native-build.cmd -Pnative-release package -DskipTests  ->  target/${artifactId}.exe        what ships
            native-build.cmd -Pnative package -DskipTests          ->  target/${artifactId}-debug.exe  for ottermate

          release: Windows GUI subsystem (no console window ever).
          debug:   console subsystem (stdout is the `automation: localhost:<port>` protocol line).
          Both carry the automation sockets, off until asked for, with the title bar's plug showing their state.
          The plugins are declared once, in pluginManagement; the profiles only choose their inputs. Both run rc.exe
          for the icon (src/main/rc) and link with MSVC, so run them through native-build.cmd (or plain mvn from a
          Visual Studio developer prompt).
        -->
        <profile>
            <id>native</id>
            <properties>
                <native.imageName>${artifactId}-debug</native.imageName>
                <native.subsystem>CONSOLE</native.subsystem>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-release</id>
            <properties>
                <native.imageName>${artifactId}</native.imageName>
                <native.subsystem>WINDOWS</native.subsystem>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Linux: mvn -Pnative-linux package -DskipTests  ->  target-linux/${artifactId}. No linker options and no
             rc.exe; a Linux executable has no subsystem and no icon of its own. Vex, Calculator and MainFrame each
             carried this profile by hand before the template did. -->
        <profile>
            <id>native-linux</id>
            <properties>
                <native.imageName>${artifactId}</native.imageName>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <buildArgs combine.self="override">
                                <buildArg>--no-fallback</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                    <!-- The camera's recording encoder beside the executable, as on Windows: ffmpeg-wrapper-record-linux's
                         libraries, flat in target-linux/ffmpeg-record, and packed as ${artifactId}-ffmpeg-record-linux-x86_64.tar.gz
                         for an installer to unpack into the install's own ffmpeg-record folder (Linux's form of
                         ffmpeg-record-zip: names in order, fixed times, owners and modes, gzip without a name or time,
                         so the same libraries make the same archive). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ffmpeg-record-beside</id>
                                <configuration>
                                    <includeArtifactIds>ffmpeg-wrapper-record-linux</includeArtifactIds>
                                    <includes>natives/record/linux-x86_64/**</includes>
                                    <outputDirectory>$${project.build.directory}/ffmpeg-record</outputDirectory>
                                    <fileMappers>
                                        <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                                    </fileMappers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ffmpeg-record-tar</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>sh</executable>
                                    <workingDirectory>$${project.build.directory}/ffmpeg-record</workingDirectory>
                                    <commandlineArgs>-c "LC_ALL=C tar --sort=name --mtime=2026-01-01T00:00:00Z --owner=0 --group=0 --numeric-owner --mode=a=r,u+w -cf - * | gzip -n > ../${artifactId}-ffmpeg-record-linux-x86_64.tar.gz"</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          This application's own icons, switched on by the folder: art in src/main/icons/small (a 16-unit grid, for
          24 px and under) or src/main/icons/large (a 64-unit grid, above), SVG or a black-on-white or transparent
          raster, one file per icon named for it (brush.svg is BRUSH). The build bakes it into ${className}Icon, a set
          that extends the suite's dev.vexelray.gui.icons.Icon: its grids, none of its names, and every place an Icon
          goes. See vexelray-gui/vexelray-gui-icons/README.md, "An application's own icons".
        -->
        <profile>
            <id>app-icons</id>
            <activation><file><exists>$${basedir}/src/main/icons</exists></file></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>dev.vexelray.gui</groupId>
                        <artifactId>vexelray-gui-icons-maven-plugin</artifactId>
                        <version>$${vexelray-gui.version}</version>
                        <executions>
                            <execution>
                                <goals><goal>bake</goal></goals>
                                <configuration>
                                    <extends>dev.vexelray.gui.icons.Icon</extends>
                                    <packageName>${packageName}</packageName>
                                    <enumName>${className}Icon</enumName>
                                    <directories>
                                        <directory>
                                            <path>src/main/icons/small</path>
                                            <size>small</size>
                                            <optional>true</optional>
                                        </directory>
                                        <directory>
                                            <path>src/main/icons/large</path>
                                            <size>large</size>
                                            <optional>true</optional>
                                        </directory>
                                    </directories>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Build-time platform selection: exactly one activates from the host OS, adding VexelRay's
             matching provider module and tactroller's input backend (both found by ServiceLoader). -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>$${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>$${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>$${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>$${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <version>$${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>$${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
