<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.framework</groupId>
        <artifactId>vexelray-framework</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-framework-automation</artifactId>

    <description>
        The driving socket, as a framework component instead of a method every application writes for
        itself. A module of its own rather than part of -shell, and deliberately: the code is identical
        in three applications and the scaffold, so it belongs in the framework, but a listening socket
        linked into every native binary is the wrong trade. An application that wants to be driven
        depends on this; one that does not never links it.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
        </dependency>
        <!-- The automation button beside the key bindings, and the window of switches it opens: a debug edition
             can be switched to driven, or to diagnostics, while it runs. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation-window</artifactId>
            <version>${vexelray.gui.version}</version>
        </dependency>
        <!-- The Inspector's link, started beside the socket (vexelray-gui docs/plans/flight-recorder.md section 6).
             Debug editions only, like this whole module, so no release binary carries elektro-Q. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-inspector-link</artifactId>
            <version>${vexelray.gui.version}</version>
        </dependency>
        <!-- AutomationStarterTest compiles applications against the starter with the real processor. Test
             scope, which also puts the processor before this module in the reactor. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-processor</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reached through -shell already; named here because this module calls it directly, and a
             dependency used and not declared is one a later reshuffle of -shell can take away. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-diagnostics</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.atchung</groupId>
            <artifactId>atchung-probe</artifactId>
        </dependency>
    </dependencies>
</project>
