<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.framework</groupId>
        <artifactId>vexelray-framework</artifactId>
        <version>0.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-framework-shell</artifactId>

    <description>
        The absorbed application edge. Opening an input backend and settling its coordinate space,
        installing a clipboard, remembering where the window was, attaching a clock, wiring the frame loop
        and its wakes, and deciding what closing the window means — taken as defaults rather than retyped
        per application. This is the only module that is Vulkan-aware; -api and -core stay JDK-only.
    </description>

    <dependencies>
        <!-- Test scope only, and read rather than run: FrameworkTableTest holds the processor's table of Shell
             accessors, which it can only name by string, against the Shell they name. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-processor</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-core</artifactId>
        </dependency>

        <!-- What is being wired: Gui, GuiApp, Settings, WindowMemory, and the frame loop. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
        </dependency>
        <!-- The frame clock. Attached before the tree, because a widget that animates is handed its timing
             at construction — see Phase.GUI. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
        </dependency>
        <!-- TitleBar. The framework builds the bar so its instrument strip means the same thing in
             every window (automation.md 7); the application still supplies every colour in it. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
        </dependency>
        <!-- The save dialog the screenshot instrument asks through. A desktop application's working directory
             is wherever it was launched from, so a picture filed there is a picture nobody can find. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-nfd</artifactId>
        </dependency>

        <!-- Input, and the bridge that puts it on the bus. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-api</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
        </dependency>

        <!-- The frame loop, run for real against windows that are never shown. Test scope: this is what makes
             the wake and deadline seams assertable end to end rather than as arithmetic. Needs a Vulkan
             device — see WakeSeamsTest. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-harness</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Where this module says it dropped something a consumer asked for: input, the clipboard, the app
             icon. Warn-once, on by default, and recorded so a test can prove the warning fires. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-diagnostics</artifactId>
        </dependency>
        <!-- The logger every record in this module goes through, and the configuration that decides where it
             goes. Reached through -diagnostics already; named because this module calls it directly. -->
        <dependency>
            <groupId>sibarum.atchung</groupId>
            <artifactId>atchung-probe</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-canvas</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-os-api</artifactId>
        </dependency>
        <!-- FrameworkShader: the canvas shader every application on the framework draws with. Reachable through
             -widget already; named because this module names Effects itself. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-shadelets</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The VexelRay mark as an art pair, for the About window to condense: its shape as a two-range
              distance field and its colour at each display scale, baked from the drawing the logo is made from.
              The orb is lifted out of the shape, since the window lands a live one where it sits.
            -->
            <plugin>
                <groupId>dev.vexelray.gui</groupId>
                <artifactId>vexelray-gui-icons-maven-plugin</artifactId>
                <version>${vexelray.gui.version}</version>
                <executions>
                    <execution>
                        <id>about-art</id>
                        <goals>
                            <goal>pair</goal>
                        </goals>
                        <configuration>
                            <pairs>
                                <pair>
                                    <art>src/main/rc/vexelray-logo.svg</art>
                                    <name>dev/vexelray/framework/shell/vexelray-logo</name>
                                    <sizes>52,104,156,208</sizes>
                                    <field>128</field>
                                    <lift>orb</lift>
                                </pair>
                            </pairs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Pre-compile FrameworkShader to SPIR-V at build time, as vexelray-canvas does the core set:
              META-INF/supirvast/shaders/canvas.frag.<hash>.spv in this jar. Without it the shader is lowered on
              the main thread at every application's startup, and said to be. The plugin scans this module's
              classes for shaders, so the composition is a class here with a public no-arg constructor.
            -->
            <plugin>
                <groupId>dev.supirvast</groupId>
                <artifactId>supirvast-maven-plugin</artifactId>
                <version>${supirvast.version}</version>
                <executions>
                    <execution>
                        <id>precompile-shaders</id>
                        <goals>
                            <goal>compile-shaders</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
