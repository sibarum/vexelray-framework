<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.framework</groupId>
        <artifactId>vexelray-framework</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-framework-acceptance</artifactId>

    <description>
        The acceptance loop: generate a project from the builder, check the tree in memory, write it, build it
        with Maven, and drive the running application through its automation socket. Only in the reactor under
        -Pacceptance, because building the generated project needs every module of this repo and of the stack
        installed, and driving it needs a window and a GPU. It holds no main code; the loop is its test.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-template</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Not called: named so the reactor installs what the generated project builds against before this
             module's test runs. A reactor orders by dependency, and without these it could run the loop first. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-automation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-processor</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- The Maven running this build, so the generated project is built by the same one,
                             against the same local repository the reactor just installed into. -->
                        <acceptance.maven>${maven.home}</acceptance.maven>
                        <acceptance.repository>${settings.localRepository}</acceptance.repository>
                        <acceptance.version>${project.version}</acceptance.version>
                        <acceptance.dir>${project.build.directory}/acceptance</acceptance.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
